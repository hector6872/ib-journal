# ==========================================
# IBKR Trading Journal Configuration
# ==========================================

# Interactive Brokers Flex Web Service Credentials
IBKR_TOKEN=your_ibkr_flex_token_here
IBKR_QUERY_ID=your_flex_query_id_here

# Server Settings
HOST=0.0.0.0
PORT=8000

# Market & Sync Settings
# Timezone for market hours checking (e.g. Europe/Madrid, America/New_York, UTC)
MARKET_TIMEZONE=Europe/Madrid
# Market operating hours in 24h format (e.g., 09:00 - 17:30 for EU, 15:30 - 22:00 for US)
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=0
MARKET_CLOSE_HOUR=22
MARKET_CLOSE_MINUTE=0

# Sync interval in minutes during market hours
SYNC_INTERVAL_MINUTES=60

# Minimum cooldown in seconds between manual "Sync Now" requests
SYNC_COOLDOWN_SECONDS=600

# Base Currency Symbol displayed in UI
CURRENCY_SYMBOL=€

# Path to SQLite DB (stored on disk or mounted volume)
DB_PATH=data/journal.db
