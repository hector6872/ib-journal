# ==========================================
# IBKR Trading Journal Configuration
# ==========================================

# Interactive Brokers Flex Web Service Credentials
IBKR_TOKEN=your_ibkr_flex_token_here

# Query 1 (Essential): Daily Activity & Cash Movements (Activity Flex Query, runs once daily at DAILY_ACTIVITY_SYNC_HOUR UTC)
IBKR_ACTIVITY_QUERY_ID=your_activity_query_id_here
# Legacy alias: IBKR_QUERY_ID can also be used if only using a single query
# IBKR_QUERY_ID=your_activity_query_id_here

# Query 2 (Optional): Real-time Intraday Executions (Trade Confirmation Flex Query, runs every 15 min during market hours)
IBKR_TRADE_QUERY_ID=your_trade_confirmation_query_id_here

# Environment Mode: 'prod' (production with background auto-sync) or 'dev' / 'debug' (manual sync only)
ENVIRONMENT=prod
DEBUG=false

# Server Settings
HOST=0.0.0.0
PORT=8000

# Sync Settings
# SYNC_MODE options:
#   'global'  - 24/5 from Sunday 22:00 UTC to Friday 22:00 UTC (APAC, Europe, US, Forex, Futures)
#   'western' - 07:00 to 00:00 UTC (09:00 to 02:00 CET), Monday to Friday (Europe & full US After-Hours)
#   'always'  - 24/7 continuous synchronization
SYNC_MODE=global
SYNC_INTERVAL_MINUTES=15
SYNC_COOLDOWN_SECONDS=300
DAILY_ACTIVITY_SYNC_HOUR=6


# Path to SQLite DB (stored on disk or mounted volume)
DB_PATH=data/journal.db
